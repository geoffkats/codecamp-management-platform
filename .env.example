APP_NAME="Code Academy Uganda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (use mysql on the VPS) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=codecamp
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Mail ---
# Local: MAIL_MAILER=log
# Hostinger mailbox: smtp.hostinger.com, port 465, MAIL_SCHEME=smtps
# Gmail: smtp.gmail.com, port 587, MAIL_SCHEME=tls
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Features ---
FEATURE_CODE_CLUB=true

# --- Certificates (DomPDF is the default; no LibreOffice needed) ---
CERTIFICATE_USE_DOMPDF=true
CERTIFICATE_AUTO_GENERATE_ON_COMPLETION=false
CERTIFICATE_USE_BACKGROUND=true
CERTIFICATE_BRAND_COLOR=#1546c0
CERTIFICATE_LABEL_COLOR=#2d7fd4
CERTIFICATE_BORDER_WIDTH_MM=5
CERTIFICATE_MODULE_VERSION=1.0
CERTIFICATE_MIN_PROGRESS_PERCENT=80
CERTIFICATE_EXECUTIVE_DIRECTOR="Edward Ssempala, Executive Director Code Academy Uganda"
# CERTIFICATE_BACKGROUND=
# CERTIFICATE_LOGO=

# Optional wkhtmltopdf fallback (leave unset unless installed on the server)
# WKHTMLTOPDF_BINARY=/usr/bin/wkhtmltopdf
# WKHTMLTOIMAGE_BINARY=/usr/bin/wkhtmltoimage

# --- Code Club reports ---
CODECLUB_REPORT_USE_DOMPDF=true
CODECLUB_REPORT_ADDRESS="Plot 12, Kampala Road, Kampala, Uganda"
CODECLUB_REPORT_PHONE="+256 700 000 000"
CODECLUB_REPORT_EMAIL=info@codeacademy.ug
CODECLUB_REPORT_WEBSITE=www.codeacademy.ug
CODECLUB_REPORT_SOCIAL=@CodeAcademyUG
CODECLUB_REPORT_TERM_LABEL=

# --- Attendance & daily reports ---
ATTENDANCE_CHECK_IN_START=08:00
ATTENDANCE_CHECK_IN_END=10:00
ATTENDANCE_LATE_AFTER=09:30
ATTENDANCE_LOCK_TIME=17:00
ATTENDANCE_MIN_CHECKOUT_MINUTES=60
ATTENDANCE_DEFAULT_CLOCK_OUT=17:00
ATTENDANCE_TEACHER_BACKFILL_DAYS=30
CLUB_CHECK_IN_EARLY_MINUTES=15
CLUB_LATE_GRACE_MINUTES=15
CLUB_MIN_CHECKOUT_MINUTES=30
CLUB_DEFAULT_SESSION_START=15:00
CLUB_DEFAULT_SESSION_END=16:30
DAILY_REPORT_CUTOFF=17:00
DAILY_REPORT_GRACE=60

# --- Code Academy Uganda registration lookup ---
CAU_REGISTRATION_API_ENABLED=false
CAU_REGISTRATION_API_URL=https://codeacademyug.org
CAU_REGISTRATION_API_KEY=
CAU_REGISTRATION_API_TIMEOUT=10

# --- Curriculum AI assistant ---
GEMINI_API_KEY=

# Google Tag Manager (preferred). Example: GTM-XXXXXXX
GOOGLE_GTM_ID=

# GA4 Measurement ID. Used only when GOOGLE_GTM_ID is empty (direct gtag.js).
# Example: G-XXXXXXXXXX
GOOGLE_GA4_MEASUREMENT_ID=

# Google Ads conversion credentials — configure inside GTM (or Ads UI).
# Conversion ID example: AW-XXXXXXXXX
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=

# --- Optional: keep debugbar off in production ---
DEBUGBAR_ENABLED=false
